# Node 22.18+. Copy this file to .env. Restart after changing configuration.
PORT=3210
APP_NAME=Zyrah
CHARACTER_NAME=Zyrah
# mao_en/runtime is the default visual model; svg restores the original illustration.
AVATAR_PROVIDER=live2d
# demo = scripted, no model. openai = real AI; ollama = local model.
CHAT_PROVIDER=demo
CHAT_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b
# omnivoice = installed local neural runtime. Unavailable files produce text, never OS fallback.
TTS_PROVIDER=omnivoice
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_VOICE=fil-PH-BlessicaNeural
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
STT_MODEL=gpt-4o-mini-transcribe
# Desktop defaults to %APPDATA%/Zyrah/data. Browser defaults to ./data.
# DATA_DIR=C:/absolute/path/to/data
# Embeddings: local = deterministic lexical vectors; openai = learned multilingual vectors.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
DAILY_PROVIDER_REQUESTS=250
DAILY_SPEECH_CHARACTERS=25000
PROVIDER_TIMEOUT_MS=60000
# Only retries HTTP 429/503, never an ambiguous network failure.
PROVIDER_RETRIES=0

# Optional VoiceStudio or another compatible LOOPBACK service. No engines downloaded automatically.
# STT_PROVIDER defaults to openai if a key exists, otherwise browser.
# STT_PROVIDER=local
# TTS_PROVIDER=local
LOCAL_SPEECH_BASE_URL=http://127.0.0.1:3900/v1
LOCAL_SPEECH_API_KEY=
LOCAL_TTS_MODEL=omnivoice
LOCAL_TTS_VOICE=default
LOCAL_STT_MODEL=faster-whisper
# AUDITION_ENGINES=omnivoice,voxcpm2

# Strict mode rejects unaudited external local services as well as cloud APIs.
OFFLINE_ONLY=false
# STT_PROVIDER=faster-whisper
# WHISPER_PYTHON=C:/absolute/path/to/updated-files/speech/.venv/Scripts/python.exe
# WHISPER_MODEL_PATH=C:/absolute/path/to/downloaded/multilingual-model
# STT_PROVIDER=disabled and TTS_PROVIDER=disabled provide explicit text-only mode.

# Explicit setup: speech/setup-neural.ps1. Choose device using runtime --list-devices.
NEURAL_TTS_EXE=speech/tools/omnivoice-vulkan/omnivoice-tts.exe
NEURAL_TTS_DEVICE=CPU
# This checked machine uses Vulkan1 (RTX 2050); enumerate devices on other hardware.
NEURAL_TTS_REFERENCES=speech/voices
