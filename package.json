{
  "name": "Zy-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An original Filipino AI companion, with local memory and interruptible voice.",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "setup:avatar": "node scripts/setup-avatar.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  }
}
